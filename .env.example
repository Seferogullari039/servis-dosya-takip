# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sunucu tarafı ONLY — asla NEXT_PUBLIC_ ile paylaşmayın
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Web (PWA push — client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (sunucu push gönderimi — Vercel)
# Firebase Console → Project settings → Service accounts → Generate new private key
# JSON dosyasının tamamını tek satır string olarak yapıştırın:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Development admin seed (opsiyonel)
SEED_ADMIN_EMAIL=seferogullari@servis.com
SEED_ADMIN_PASSWORD=Alper123

# Production opsiyonel
# LOG_LEVEL=warn
# CACHE_BACKEND=memory
# READONLY_MODE=false
# SAFE_MODE=false
